# =============================================================================
# DocuStruct AI — Environment Template (.env.example)
# Copy to .env and insert your API credentials
# =============================================================================

# 1. Multi-LLM Provider API Keys
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
ZAI_API_KEY=""
TOGETHER_API_KEY=""
OPENROUTER_API_KEY=""

# 2. Provider Base URLs
GROQ_BASE_URL="https://api.groq.com/openai/v1"
TOGETHER_BASE_URL="https://api.together.xyz/v1"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
ZAI_BASE_URL="https://api.z.ai/v1"

# 3. Security Limits (Phase 1)
DOCUSTRUCT_MAX_FILE_SIZE_BYTES=52428800
DOCUSTRUCT_MAX_PDF_PAGES=100
